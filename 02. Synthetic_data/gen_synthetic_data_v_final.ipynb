    }
   ],
   "source": [
    "sc = StandardScaler().fit(ref[NUM].to_numpy(float))\n",
    "Z  = sc.transform(ref[NUM].to_numpy(float))\n",
    "\n",
    "gm = GaussianMixture(N_COMP, covariance_type=\"full\", n_init=3, random_state=SEED).fit(Z)\n",
    "print(f\"GMM {N_COMP} thanh phan | log-likelihood = {gm.score(Z):.4f}\")\n",
    "\n",
    "comp_ref = gm.predict(Z)  "
   ]
