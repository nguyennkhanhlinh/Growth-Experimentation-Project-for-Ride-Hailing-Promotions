    "def smd(a, b):\n",
    "    a, b = np.asarray(a, float), np.asarray(b, float)\n",
    "    s = np.sqrt((a.var() + b.var())/2)\n",
    "    return 0.0 if s == 0 else abs(a.mean()-b.mean())/s\n",
    "\n",
    "COV = [\"total_rides\",\"resid_tip_rate\",\"is_urban\",\"pct_airport\",\n",
    "       \"route_entropy\",\"weekend_ratio\",\"avg_fare\",\"age\"]\n",
    "bal = pd.DataFrame({\n",
    "    \"SMD_rct\": [smd(df.loc[df.T_rct==1, c], df.loc[df.T_rct==0, c]) for c in COV],\n",
    "    \"SMD_obs\": [smd(df.loc[df.T_obs==1, c], df.loc[df.T_obs==0, c]) for c in COV],\n",
    "}, index=COV).round(4)\n",
    "display(bal)\n",
