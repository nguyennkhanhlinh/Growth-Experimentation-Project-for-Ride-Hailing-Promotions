    "def entropy(r):\n",
    "    _, c = np.unique(r, return_counts=True); p = c / c.sum()\n",
    "    return float(-(p * np.log(p)).sum())\n",
    "\n",
    "ku = pd.read_csv(f\"{KAG}/users.csv\", parse_dates=[\"registration_date\"])\n",
    "kr = pd.read_csv(f\"{KAG}/rides.csv\", parse_dates=[\"ride_start_time\"])\n",
    "asof = kr.ride_start_time.max().normalize() + pd.Timedelta(days=1)\n",
    "last = kr.groupby(\"user_id\").ride_start_time.max().reindex(ku.user_id)\n",
    "rec_days = (asof - last).dt.days.fillna((asof - kr.ride_start_time.min()).days)\n",
    "Q = np.linspace(0, 1, 1001)\n",
    "q_age, q_rec = np.quantile(ku.age, Q), np.quantile(rec_days, Q)\n",
    "pmf_g = ku.gender.value_counts(normalize=True)\n",
    "\n",
    "zl = pd.read_csv(f\"{B}/data/taxi_zone_lookup.csv\")\n",
    "bmap = dict(zip(zl.LocationID, zl.Borough.fillna(\"Unknown\")))\n",
    "BUCKET = {**{h: \"morning\" for h in range(6, 10)}, **{h: \"midday\" for h in range(10, 16)},\n",
    "          **{h: \"evening\" for h in range(16, 22)},\n",
    "          **{h: \"late_night\" for h in list(range(22, 24)) + list(range(0, 6))}}\n",
    "\n",
    "rec = []\n",
    "for idx in trips:\n",
    "    s = d.iloc[idx]; rt = s.resid_tip.dropna()\n",
    "    rec.append({\n",
    "        \"total_rides\": len(idx),\n",
    "        \"typical_distance\": s.trip_distance.median(),\n",
    "        \"route_entropy\": entropy(ROUTE[idx]),\n",
    "        \"pct_airport\": s.is_air.mean(),\n",
    "        \"weekend_ratio\": s.is_wknd.mean(),\n",
    "        \"pct_flex_payment\": s.is_flex.mean(),\n",
    "        \"resid_tip_rate\": rt.mean() if len(rt) else 0.0,\n",
    "        \"avg_fare\": s.fare_amount.mean(),\n",
    "        \"pref_time_bucket\": BUCKET[int(s.hour.mode().iloc[0])],\n",
    "        \"home_borough\": bmap.get(int(s.PULocationID.mode().iloc[0]), \"Unknown\"),\n",
    "    })\n",
    "\n",
    "ref = pd.DataFrame(rec)\n",
    "ref[\"age\"]          = np.interp(rng.random(N_RIDERS), Q, q_age).round().astype(np.int16)\n",
    "ref[\"gender\"]       = rng.choice(pmf_g.index, N_RIDERS, p=pmf_g.values)\n",
    "ref[\"recency_days\"] = np.interp(rng.random(N_RIDERS), Q, q_rec).round().astype(np.int16)\n",
    "\n",
    "NUM = [\"total_rides\", \"typical_distance\", \"route_entropy\", \"pct_airport\", \"weekend_ratio\",\n",
    "       \"pct_flex_payment\", \"resid_tip_rate\", \"avg_fare\", \"age\", \"recency_days\"]\n",
    "CAT = [\"gender\", \"home_borough\", \"pref_time_bucket\"]\n",
    "\n",
    "display(ref[NUM].describe().round(3))"
   ]
  },
