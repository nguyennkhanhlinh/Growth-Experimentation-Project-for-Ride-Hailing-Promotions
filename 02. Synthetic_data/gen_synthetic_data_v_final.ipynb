    "Zs, comp = gm.sample(N_RIDERS)\n",
    "p = rng.permutation(N_RIDERS)          # gm.sample() tra ve xep theo thanh phan\n",
    "Zs, comp = Zs[p], comp[p]\n",
    "\n",
    "syn = pd.DataFrame(index=range(N_RIDERS))\n",
    "for j, c in enumerate(NUM):\n",
    "    ordr = np.argsort(np.argsort(Zs[:, j]))\n",
    "    q  = np.sort(ref[c].to_numpy(float))\n",
    "    lo = q[ordr]\n",
    "    hi = q[np.minimum(ordr + 1, N_RIDERS - 1)]\n",
    "    prev  = q[np.maximum(ordr - 1, 0)]\n",
    "    atom  = (hi == lo) | (prev == lo)              \n",
    "    syn[c] = np.where(atom, lo, lo + (hi - lo) * rng.random(N_RIDERS))\n",
    "\n",
    "syn[\"total_rides\"]  = syn.total_rides.round().clip(1, None).astype(int)\n",
    "syn[\"age\"]          = syn.age.round().clip(18, 65).astype(int)\n",
    "syn[\"recency_days\"] = syn.recency_days.round().clip(0, None).astype(int)\n",
    "for c in [\"pct_airport\", \"weekend_ratio\", \"pct_flex_payment\"]:\n",
    "    syn[c] = syn[c].clip(0, 1)\n",
    "\n",
    "syn[\"route_entropy\"] = syn.route_entropy.clip(lower=0)\n",
    "for c in [\"typical_distance\", \"avg_fare\"]:\n",
    "    syn[c] = syn[c].round(3)\n",
    "syn[\"resid_tip_rate\"] = syn.resid_tip_rate.round(6)\n",
    "\n",
    "# bien phan loai: rut theo P(cat | thanh phan GMM)\n",
    "for c in CAT:\n",
    "    vals = np.empty(N_RIDERS, dtype=object)\n",
    "    for k in range(N_COMP):\n",
    "        m_syn = comp == k\n",
    "        if m_syn.sum() == 0: continue\n",
    "        pk = ref.loc[comp_ref == k, c].value_counts(normalize=True)\n",
    "        if len(pk) == 0: pk = ref[c].value_counts(normalize=True)\n",
    "        vals[m_syn] = rng.choice(pk.index, m_syn.sum(), p=pk.values)\n",
    "    syn[c] = vals\n",
    "\n",
    "COLS = [\"user_id\", \"age\", \"gender\", \"home_borough\", \"total_rides\", \"recency_days\",\n",
    "        \"typical_distance\", \"route_entropy\", \"pct_airport\", \"pref_time_bucket\",\n",
    "        \"weekend_ratio\", \"pct_flex_payment\", \"resid_tip_rate\", \"avg_fare\"]\n",
    "syn.insert(0, \"user_id\", np.arange(1, N_RIDERS + 1))\n",
    "syn = syn[COLS]\n",
    "assert len(COLS) == 14\n",
    "display(syn.head())"
   ]
