    "d[\"tip_band\"] = pd.qcut(d.resid_tip.fillna(d.resid_tip.median()), 5,\n",
    "                        labels=False, duplicates=\"drop\").astype(np.int8)\n",
    "POOL = {(a, b): d.index[(d.arch == a) & (d.tip_band == b)].to_numpy()\n",
    "        for a in range(N_ARCH) for b in range(5)}\n",
    "\n",
    "POOL_ARCH = {a: d.index[d.arch == a].to_numpy() for a in range(N_ARCH)}\n",
    "_empty = [(a, b) for (a, b), v in POOL.items() if len(v) == 0]\n",
    "print(f\"O (archetype x tang tip) rong: {len(_empty)}/{N_ARCH*5}  -> dung du phong theo archetype\")\n",
    "ROUTE = (d.PULocationID.to_numpy().astype(np.int32) * 1000\n",
    "         + d.DOLocationID.to_numpy().astype(np.int32))\n",
    "\n",
    "u   = norm.cdf(rng.standard_normal(N_RIDERS))\n",
    "n_i = nbinom.ppf(np.clip(u, 1e-6, 1-1e-6), 3, 0.3).astype(int) + 1   # so chuyen\n",
    "b_i = Beta.ppf(np.clip(u, 1e-6, 1-1e-6), 2.2, 2.2)                   # do lap tuyen\n",
    "t_i = np.clip((u * 5).astype(int), 0, 4)                             # tang tip\n",
    "w_i = rng.dirichlet(ALPHA * p_arch * N_ARCH, size=N_RIDERS)               # khau vi\n",
    "\n",
    "trips = []\n",
    "for i in range(N_RIDERS):\n",
    "    n = int(n_i[i]); idx, seen = [], []\n",
    "    for a in rng.choice(N_ARCH, size=n, p=w_i[i]):\n",
    "        p = POOL[(a, t_i[i])]\n",
    "        if len(p) == 0: p = POOL_ARCH[a]\n",
    "        if seen and rng.random() < b_i[i]:\n",
    "            idx.append(seen[rng.integers(len(seen))])       # lap lai tuyen quen\n",
    "        else:\n",
    "            j = p[rng.integers(len(p))]; idx.append(j); seen.append(j)\n",
    "    trips.append(np.array(idx))\n",
    "    if (i+1) % 5000 == 0: print(f\"  {i+1:,}/{N_RIDERS:,}\")\n",
    "print(\"Oke\")"
   ]
